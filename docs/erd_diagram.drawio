<mxfile host="app.diagrams.net" agent="claude-code" version="24.0.0" type="device">
  <diagram id="momo-erd" name="MoMo SMS ERD">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1020" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="MoMo SMS Data Processing System — Entity Relationship Diagram" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="800" height="30" as="geometry" />
        </mxCell>

        <!-- transaction_categories -->
        <mxCell id="cat" value="transaction_categories" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=1;resizeParent=0;resizeParentMax=0;collapsible=0;marginBottom=0;fillColor=#ffffff;strokeColor=#0f766e;swimlaneFillColor=#0f766e;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="160" y="60" width="280" height="140" as="geometry" />
        </mxCell>
        <mxCell id="cat1" value="PK  category_id  INT" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontColor=#7c2d12;fontStyle=1;" vertex="1" parent="cat">
          <mxGeometry y="30" width="280" height="22" as="geometry" />
        </mxCell>
        <mxCell id="cat2" value="UK  category_code  VARCHAR(30)" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="cat">
          <mxGeometry y="52" width="280" height="22" as="geometry" />
        </mxCell>
        <mxCell id="cat3" value="category_name  VARCHAR(100)" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="cat">
