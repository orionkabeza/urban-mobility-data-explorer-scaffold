        <mxCell id="sms7" value="service_center, readable_date, ingested_at, sms_protocol, sms_type, sms_date_sent" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontColor=#6b7280;fontSize=10;whiteSpace=wrap;" vertex="1" parent="sms">
