        <mxCell id="log" value="system_logs" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=1;resizeParent=0;resizeParentMax=0;collapsible=0;marginBottom=0;fillColor=#ffffff;strokeColor=#4338ca;swimlaneFillColor=#4338ca;fontColor=#ffffff;" vertex="1" parent="1">
