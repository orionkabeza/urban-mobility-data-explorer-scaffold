        <!-- transaction_participants (junction) -->
        <mxCell id="tp" value="transaction_participants&#10;(junction table — resolves users : transactions M:N)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=44;horizontalStack=1;resizeParent=0;resizeParentMax=0;collapsible=0;marginBottom=0;fillColor=#fffbeb;strokeColor=#a16207;swimlaneFillColor=#a16207;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
