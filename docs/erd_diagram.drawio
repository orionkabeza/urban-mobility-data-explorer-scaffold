        <mxCell id="cat5" value="description  VARCHAR(255)" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontColor=#6b7280;" vertex="1" parent="cat">
          <mxGeometry y="118" width="280" height="22" as="geometry" />
        </mxCell>

        <!-- sms_messages -->
        <mxCell id="sms" value="sms_messages" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=1;resizeParent=0;resizeParentMax=0;collapsible=0;marginBottom=0;fillColor=#ffffff;strokeColor=#7c3aed;swimlaneFillColor=#7c3aed;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="1000" y="60" width="300" height="206" as="geometry" />
